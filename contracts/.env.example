SEPOLIA_RPC_URL=
# Read-only fork tests; the default block was exercised during the integration review.
# publicnode's free endpoint intermittently lacks archive state for specific accounts at this pinned
# block ("historical state ... is not available") even though it's reachable and current-tip queries
# work fine on it — verified live, not assumed. Tenderly's public gateway had full archive state for
# every account these tests touch; swap back to a free endpoint only after confirming the same.
SEPOLIA_RPC_URL_FORK=https://sepolia.gateway.tenderly.co
SEPOLIA_FORK_BLOCK=11784342
# Optional multi-user fork load (1..1000). Values above the default may need a larger local gas limit.
STRESS_USERS=256
DEPLOYER_PK=
ETHERSCAN_API_KEY=
BACKEND_SIGNER=

# Uniswap v4 — Sepolia, verified against docs.uniswap.org/contracts/v4/deployments on 2026-09-26.
POOL_MANAGER=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
POOL_SWAP_TEST=0x9b6b46e2c869aa39918db7f52f5557fe577b6eee
POOL_MODIFY_LIQUIDITY_TEST=0x0c478023803a644c94c4ce1c1e7b9a087e411b0a
# NOT independently verified against a Uniswap-specific source (only a high-tx-count Etherscan
# contract) — reconfirm before a real deploy.
WETH=0x7b79995e5f793A07Bc00c21412e50Ecae098E7f9

# ENSv2 beta — Sepolia, verified against docs.ens.domains/learn/deployments on 2026-09-26.
# ENS_REGISTRY = the ETHRegistry (a PermissionedRegistry rooted at .eth) — used to register surety.eth
# itself (a one-time manual step, task A1 — not run by any script here).
ENS_REGISTRY=0x657ea849311d3d5823348dDEd7c2aAafB3edE09e
ENS_ETH_REGISTRAR=0xabe76f6c8dFCEd81aa5A2Bb8034202a7136B94ca
ENS_VERIFIABLE_FACTORY=0x9e726eb570bEB6bCeB495aB8CDa7Df517D4e841c
ENS_PERMISSIONED_RESOLVER_IMPL=0x14F09fD05D4585759e54844DC9b00147131CF243
# ENS_PARENT_REGISTRY = surety.eth's OWN registry contract, once registered (fill in after task A1;
# TEAM_PLAN §3 fallback: a pre-registered test name's registry instead). ENS_PARENT_LABEL defaults to
# "surety" in Deploy.s.sol if unset — override for the fallback name.
ENS_PARENT_REGISTRY=
ENS_PARENT_LABEL=surety

# Person B's contracts — leave unset for a chain-layer-only deploy; Deploy.s.sol logs a warning and
# skips the corresponding wiring rather than failing.
WORLD_ID_GATE=
CLAIM_ROUTER=

# SeedDemo.s.sol — the World ID enrollment attestation, produced by Person B's backend after a real
# (or sandbox) OIDC round trip (PRD §11.1). Everything else below has a sensible default in the script.
ENROLL_SUB_HASH=
ENROLL_EXPIRY=
ENROLL_SIG=
DEMO_POLICYHOLDER=
DEMO_AGENT=
DEMO_ALLOWED_COUNTERPARTY=
DEMO_COVERAGE=
DEMO_PER_TX_CAP=
DEMO_BACKING=
DEMO_AGENT_DEPOSIT=
