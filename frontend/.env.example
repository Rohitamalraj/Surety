# Surety backend (World ID validation, indexer, demo agent)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8787
# local = anvil devnet (backend: npm run devnet) · sepolia = real deployment
NEXT_PUBLIC_NETWORK=sepolia
# optional RPC override (defaults: http://127.0.0.1:8545 local, public Sepolia RPC otherwise)
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_ENS_PARENT=surety.eth
