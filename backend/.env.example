PORT=8787
# Public HTTPS origin of this backend. The World ID pairwise `sub` is scoped to this hostname — never change it after users enroll.
PUBLIC_URL=https://surety-backend.example.com
FRONTEND_URL=http://localhost:3000

# World ID for Agents (register a confidential client at https://sandbox.auth.world.org/portal)
WORLDID_ISSUER=https://sandbox.auth.world.org
WORLDID_CLIENT_ID=
WORLDID_CLIENT_SECRET=
# client_secret_basic (portal default) | client_secret_post
WORLDID_AUTH_METHOD=client_secret_basic

# Chain
SEPOLIA_RPC_URL=
CHAIN_ID=11155111
# Signs EIP-712 attestations AND sends markHeld / executeWithApproval txs (needs Sepolia ETH)
BACKEND_SIGNER_PK=
# Agent simulator key (the insured agent)
AGENT_PK=

# IDKit — proof of unique human before buying a policy (https://developer.world.org)
IDKIT_APP_ID=
IDKIT_RP_ID=
# RP signing key from the Developer Portal — secret, backend only
IDKIT_SIGNING_KEY=
IDKIT_ACTION=surety-buy-policy
# staging = World ID Simulator (https://simulator.worldcoin.org); production = real World App
IDKIT_ENVIRONMENT=staging
# Staging window token (simulator testing only; expires after 24h). Leave empty in production.
IDKIT_STAGING_TOKEN=
# Optional: RPC for event indexing (needs wide eth_getLogs ranges). Default: Tenderly public Sepolia gateway.
INDEXER_RPC_URL=
